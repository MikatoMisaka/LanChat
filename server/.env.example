CHAT_DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.chat.example.com
# Host name only: do not include https://, a path, or spaces.
SYNAPSE_SERVER_NAME=chat.example.com
LANCHAT_SERVER_NAME=My LanChat Server

# Optional override. Domain mode derives this from CHAT_DOMAIN automatically.
# LANCHAT_PUBLIC_BASEURL=https://chat.example.com/

# Optional compatibility values. If the administrator password is omitted, the
# control service prints a one-time setup code in its first-start log.
LANCHAT_BOOTSTRAP_ADMIN_PASSWORD=
# Optional initial group invite. It can also be created from the control room.
LANCHAT_BOOTSTRAP_ACCESS_CODE=

# Pin this to a reviewed Synapse image for production.
SYNAPSE_IMAGE=matrixdotorg/synapse:latest

# Optional Docker image registry override for the control-service Dart image.
# Keep the default unless your Docker Hub mirror cannot pull dart:3.13.0.
# LANCHAT_DART_IMAGE=m.daocloud.io/docker.io/library/dart:3.13.0
