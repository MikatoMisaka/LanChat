CHAT_DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.chat.example.com
SYNAPSE_SERVER_NAME=chat.example.com
LANCHAT_SERVER_NAME=My LanChat Server

# Set these before the first `docker compose up`; they are hashed on disk.
LANCHAT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
LANCHAT_BOOTSTRAP_ACCESS_CODE=replace-with-a-long-server-access-code

# Optional Synapse Admin API token. Leave empty until user administration is configured.
SYNAPSE_ADMIN_TOKEN=

# Pin this to a reviewed Synapse image for production.
SYNAPSE_IMAGE=matrixdotorg/synapse:latest

# Optional Docker image registry override for the control-service Dart image.
# Keep the default unless your Docker Hub mirror cannot pull dart:3.13.0.
# LANCHAT_DART_IMAGE=m.daocloud.io/docker.io/library/dart:3.13.0
