{
    email {$ACME_EMAIL}
    acme_ca https://acme.zerossl.com/v2/DV90
    acme_eab {
        key_id {$ACME_EAB_KEY_ID}
        mac_key {$ACME_EAB_MAC_KEY}
    }
}

{$CHAT_DOMAIN} {
    @control path /_lanchat/* /api/* /healthz
    handle @control {
        reverse_proxy control:8080
    }
    handle {
        reverse_proxy synapse:8008
    }
}

{$ADMIN_DOMAIN} {
    reverse_proxy control:8080
}
